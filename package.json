{
  "name": "doculens",
  "displayName": "DocuLens",
  "description": "Visualize seus documentos DOCX sem sair do VS Code.",
  "publisher": "doculens",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "docx",
    "viewer",
    "preview",
    "document"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gabriel-afk-9/docu-lens.git"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "doculens.docxViewer",
        "displayName": "DocuLens",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "DocuLens",
      "properties": {
        "doculens.maxFileSize": {
          "type": "number",
          "default": 20971520,
          "minimum": 1048576,
          "description": "Tamanho máximo do arquivo DOCX em bytes (default 20 MB). Verificado antes de carregar em memória via stat."
        },
        "doculens.renderTimeout": {
          "type": "number",
          "default": 15000,
          "minimum": 5000,
          "description": "Timeout de renderização em milissegundos (default 15000 ms). Não cancela docx-preview, apenas interrompe o aguardo."
        }
      }
    }
  },
  "scripts": {
    "dev": "node esbuild.mjs --watch",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "pnpm build"
  },
  "packageManager": "pnpm@11.4.0",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "docx-preview": "^0.4.0"
  }
}
